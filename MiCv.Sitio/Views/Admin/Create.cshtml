@model MiCv.Sitio.Models.Admin.PersonaAdminForm
@{
    ViewData["Title"] = "Nuevo CV";
}

<div asp-validation-summary="All" class="mb-3"></div>

<form asp-action="Create" method="post" id="admin-cv-form">
    <partial name="_PersonaFormFields" model="Model" />
    <div class="admin-form-footer">
        <button type="submit" class="btn btn-primary">Crear CV</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-form.js" asp-append-version="true"></script>
}
