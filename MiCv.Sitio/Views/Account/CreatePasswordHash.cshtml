@model MiCv.Sitio.Models.Account.CreatePasswordHashViewModel
@{
    ViewData["Title"] = "Generar hash de contraseña";
    Layout = "_Layout";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h4 mb-3">Generar hash SHA-256</h1>
        <p class="small text-muted">
            Solo disponible en entorno <strong>Development</strong>. Usa el mismo algoritmo que login y registro (UTF-8 → SHA-256 → hex minúsculas).
            Copia el valor en la columna <code>Contrasenna</code> al crear usuarios en SQL.
        </p>

        <form asp-action="CreatePasswordHash" method="post" class="mb-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Generar hash</button>
            <a class="btn btn-link" asp-action="Login">Volver al login</a>
        </form>

        @if (!string.IsNullOrEmpty(Model.HashGenerado))
        {
            <div class="card border-success">
                <div class="card-header small fw-semibold bg-light border-success border-bottom">Hash para Contrasenna (64 caracteres hex)</div>
                <div class="card-body">
                    <textarea id="hash-out" class="form-control font-monospace small" rows="3" readonly>@Model.HashGenerado</textarea>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="navigator.clipboard.writeText(document.getElementById('hash-out').value)">Copiar</button>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
