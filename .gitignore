## MiCv — código fuente; sin salidas de compilación.

# Siempre ignorar carpetas bin / obj (Debug, Release, cualquier TFM, cualquier proyecto).
# Aplica en todo el repo — no se sube nada dentro de ellas.
**/bin/
**/obj/
bin/
obj/
Bin/
Obj/
[Bb]in/
[Oo]bj/

# Resto de salidas MSBuild / .NET
[Oo]ut/
artifacts/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Ll]og/
[Ll]ogs/
# Artefactos de publicación locales
[Pp]ublish/

# Ejecutables y binarios compilados (cualquier ruta residual)
*.dll
*.exe
*.pdb
*.mdb
*.nupkg
*.snupkg
*.appx
*.appxbundle
*.apk
*.ipa

# Librerías nativas de build (mantener sólo código)
*.ilk
*.lib
*.exp
*.pch
*.ipdb

# Herramientas .NET auxiliares
project.lock.json
project.fragment.lock.json

# NuGet (restauración local — no código)
**/[Pp]ackages/*

# NPM (si aparece dentro del árbol)
node_modules/

# Visual Studio / MSBuild usuario
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*_wpftmp.csproj
Generated\ Files/

# JetBrains
.idea/

# Tests y métricas
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
coverage*.json
coverage*.xml
coverage*.info
[Bb]enchmarkDotNet.Artifacts/

# Logs de herramientas
*.binlog
*.binlog.*

# Temporales y SO
*.tmp
.DS_Store
Thumbs.db
__pycache__/

# Secretos locales (opcionalmente añade tus variantes)
appsettings.*.local.json
**/secrets.json
*.pfx

# Si necesitás versionar DLL/vendor intencionalmente en una carpeta concreta, descomentá:
# !vendor/**/*.dll
